@page
@model Pepela.Pages.AdminModel

@{
    ViewData["Title"] = "Hyperadministrace";
}

@if (Model.MailSent)
{
    <div class="alert alert-primary fade show" role="alert">
        Naplánoval jsem odeslání spamu!
    </div>
}
<div>
    <p>
        <a asp-page-handler="SendMails" asp-page="Admin"
           onclick="return confirm('Fakt?')">Poslat spam</a>
    </p>
    <p>
        <a asp-page-handler="ReservationList" asp-page="Admin">Stáhnout seznam platných rezervací</a>
    </p>

    <a asp-page="Index" class="btn btn-outline-secondary">Home</a>
    <a asp-page="Admin" asp-page-handler="Logout" class="btn btn-outline-secondary">Odhlásit</a>
</div>
