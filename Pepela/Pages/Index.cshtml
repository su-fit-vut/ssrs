@page
@using Pepela.Models
@using Microsoft.Extensions.Options
@using Pepela.Configuration
@inject IOptionsSnapshot<SeatsOptions> SeatsOptions
@model IndexModel

@{
    ViewData["Title"] = "Rezervace";
    var isAdmin = await AuthorizationService.AuthorizeAsync(User, "IsAdmin") is { Succeeded: true };
}

<div class="row justify-content-center">
    <div class="col-10">
        @if (Model.Result != null)
        {
            var wasSuccess = Model.Result?.Code is ReservationAttemptResultCode.MustConfirm
                or ReservationAttemptResultCode.Updated or ReservationAttemptResultCode.Confirmed;
            var alertClass = wasSuccess ? "success" : "warning";

            <div class="alert alert-@alertClass fade show" role="alert">
                @switch (Model.Result?.Code)
                {
                    case ReservationAttemptResultCode.Updated:
                        <h3>Rezervace upravena</h3>
                        <span>
                            Úprava proběhla úspěšně. Není nutné nic potvrzovat.
                        </span>

                        break;
                    case ReservationAttemptResultCode.MustConfirm:
                        <h3>Rezervace vytvořena</h3>
                        <p>
                            <span style="font-weight:bold;">Potvrď</span>
                            rezervaci kliknutím na odkaz poslaný na zadaný e-mail.
                        </p>
                        <span>
                            Nepotvrzené rezervace jsou platné pouze @SeatsOptions.Value.UnconfirmedValidMinutes minut od založení.<br>
                            Dokud není rezervace potvrzená, můžeš na tento e-mail založit novou.<br>
                            Rezervaci můžeš kdykoliv zrušit kliknutím na odkaz v&nbsp;e-mailu.
                        </span>

                        break;
                    case ReservationAttemptResultCode.Confirmed:
                        <h3>Rezervace vytvořena a potvrzena</h3>
                        <span>
                            Aktuálně se nacházíš v&nbsp;režimu úpravy nově vytvořené rezervace.
                        </span>
                        break;
                    case ReservationAttemptResultCode.NoSeatsLeft:
                        <span>
                            Bohužel už není k&nbsp;dispozici dostatečný počet míst.
                            @if (Model.SeatsLeft > 0)
                            {
                                if (Model.SeatsLeft == 1)
                                {
                                    @:K rezervaci zbývá už jen jedno místo.
                                }
                                else if (Model.SeatsLeft < 5)
                                {
                                    @:K rezervaci zbývají už jen @Model.SeatsLeft místa.
                                }
                                else
                                {
                                    @:K rezervaci zbývá už jen @Model.SeatsLeft míst.
                                }
                            }
                            Je ale možné, že se počet míst ještě bude navyšovat. Sleduj sociální sítě Studentské unie nebo FIT discord!
                        </span>

                        break;
                    case ReservationAttemptResultCode.TimeslotError:
                        @*var slotId = Model.Result?.CollidingTimeSlot?.Id ?? -1;
                        if (slotId == ReservationService.PubQuizTeamsTimeSlotId)
                        {
                            <span>
                                Bohužel už nejsou v pubkvízu k&nbsp;dispozici místa pro další týmy.
                            </span>
                        }
                        else if (slotId == ReservationService.PubQuizSoloTimeSlotId)
                        {
                            <span>
                                Bohužel už nejsou v pubkvízu k&nbsp;dispozici místa pro lidi bez týmu.
                            </span>
                        }
                        else*@
                    {
                        <span>
                            Ve zvoleném časovém slotu pro aktivitu „@Model.Result?.CollidingTimeSlot?.ActivityName“ už bohužel není místo.
                        </span>
                    }
                        break;
                    case ReservationAttemptResultCode.TimeslotNotReservable:
                        <span>
                            Zvolený časový slot pro aktivitu „@Model.Result?.CollidingTimeSlot?.ActivityName“ teď nelze rezervovat.
                        </span>

                        break;
                    case ReservationAttemptResultCode.TimeslotCollision:
                        <span>
                            Není možné zároveň rezervovat aktivity „@Model.Result?.CollidingTimeSlot?.ActivityName“ a „@Model.Result?.CollidingTimeSlotRight?.ActivityName“ ve stejném čase!
                        </span>

                        break;
                    case ReservationAttemptResultCode.EmailTaken:
                        <span>
                            Pro tento e-mail už existuje potvrzená rezervace. Můžeš ji upravit nebo zrušit kliknutím na odkaz v&nbsp;potvrzovacím e-mailu.
                        </span>

                        break;
                    case ReservationAttemptResultCode.NoActivityChosen:
                        <span>
                            Pro vytvoření rezervace je potřeba zvolit alespoň jednu aktivitu.
                        </span>

                        break;
                    case ReservationAttemptResultCode.Error:
                        <span>
                            Vyskytla se neočekávaná chyba. Dej prosím vědět LeOvi (@@i_am_leo_) na discordu nebo na
                            <a href="mailto:xondry02@stud.fit.vut.cz">xondry02@stud.fit.vut.cz</a>.
                        </span>

                        break;
                    default:
                        throw new ArgumentOutOfRangeException();
                }
                @if (!wasSuccess && Model.EditMode)
                {
                    <span>Stávající rezervace nebyla upravena a je stále platná.</span>
                }
            </div>
        }
        else if (!ModelState.IsValid)
        {
            <div class="alert alert-danger fade show" role="alert">
                <h3>Chyba</h3>
                <p>
                    @foreach (var value in ModelState.Values)
                    {
                        foreach (var error in value.Errors)
                        {
                            <span>@error.ErrorMessage</span>
                            <br/>
                        }
                    }
                </p>
            </div>
        }

        @if (Model.SeatsLeft == 0)
        {
            <h3 class="text-danger text-center">⚠️ Kapacita naplněna ⚠️</h3>
            <p>
                Děkujeme za zájem, vypadá to, že akce bude plná. Pokud jste nestihli chytnout své místo, mrkněte sem
                ještě před začátkem, třeba někdo rezervaci zruší.
            </p>
        }
        else if (Model.SeatsLeft == 1)
        {
            <h3 class="text-danger text-center">⚠️ Zbývá poslední místo ⚠️</h3>
        }
        else if (Model.SeatsLeft < 5)
        {
            <h3 class="text-danger text-center">⚠️ Zbývají poslední @Model.SeatsLeft místa ⚠️</h3>
        }
        else if (Model.SeatsLeft < 10)
        {
            <h3 class="text-danger text-center">⚠️ Zbývá posledních @Model.SeatsLeft míst ⚠️</h3>
        }

        <h2 class="mb-4">Start@FIT 2025 – rezervace aktivit</h2>

        <p>
            Na tomto webu si můžeš zarezervovat místo na prohlídkách nebo
            v&nbsp;<a href="https://www.startatfit.cz/patek" target="_blank">pátečních</a> miniturnajích.
            <br/><span class="fw-bold">Pozor na kolize s&nbsp;programem</span> pro tvou skupinu (podle příjmení)!
            Ověř si program na <a href="https://www.startatfit.cz/" target="_blank">webu akce</a>.
            <br/>Nelze rezervovat více aktivit ve stejném čase.
            <br/>Po odeslání formuláře ti přijde e-mail s&nbsp;odkazem na potvrzení rezervace. Link je platný 10 minut.
            <br/>Rezervace je platná až po potvrzení!
        </p>
        <p class="fw-bold">
            Pokud se ti změní plány a&nbsp;na nějakou aktivitu nepřijdeš, prosím, zruš svou rezervaci (linkem v&nbsp;mailu).
        </p>

        @if (Model.SeatsLeft != 0)
        {
            <form method="post" class="mb-4">
                <div class="row mb-3">
                    <div class="col-8">
                        <label for="inputEmail" class="form-label">E-mail:</label>
                        @if (Model.EditMode)
                        {
                            <input type="email" class="form-control" id="inputEmail" asp-for="InputModel.Email"
                                   readonly="readonly">
                        }
                        else
                        {
                            <input type="email" class="form-control" id="inputEmail" asp-for="InputModel.Email"
                                   required="required">
                        }
                    </div>

                    @if (Model.MaxSeats > 1)
                    {
                        <div class="col-4">
                            <label for="inputSeats" class="form-label">Počet míst:</label>
                            <input type="number" min="1" max="@Model.MaxSeats" asp-for="InputModel.Seats"
                                   class="form-control" id="inputSeats" required="required">
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="InputModel.Seats" value="1"></input>
                    }
                </div>

                @*
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="addSleepover" asp-for="InputModel.SleepOver">
                    <label class="form-check-label" for="addSleepover">
                        Chci na FITu přespat
                    </label>
                </div>
                *@

                <hr/>

                @*
                <h3>Pubkvíz</h3>
                @if (!Model.PubQuizTeamsAvailable && !Model.PubQuizSoloAvailable)
                {
                    <p>
                        Pubkvíz už je bohužel plný.
                        Zkus se sem občas mrknout, zda se třeba neuvolnilo nějaké místo.
                    </p>
                }
                else if (!Model.PubQuizTeamsAvailable && Model.PubQuizSoloAvailable)
                {
                    <p>
                        Do pubkvízu už je možné rezervovat pouze místa pro jednotlivce (bez týmu).
                        Pozor, bude zarezervováno pouze jedno „sólo“ místo nehledě na počet osob v&nbsp;rezervaci.
                    </p>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="reserveQuizSoloSeat" asp-for="InputModel.PubQuizSolo">
                        <input type="hidden" asp-for="InputModel.PubQuizSeats" value="1">
                        <input type="hidden" asp-for="InputModel.PubQuizTeamName" value="solo">
                        <label class="form-check-label" for="reserveQuizSoloSeat">
                            Zarezervovat místo na pubkvízu
                        </label>
                    </div>
                }
                else
                {
                    <p>
                        Pro účast na pubkvízu si nejlépe předem domluv 
                        <b>tým @SeatsOptions.Value.MinPubQuizTeamSize–@SeatsOptions.Value.MaxPubQuizTeamSize lidí</b>. 
                        Níže vyplň název a&nbsp;velikost týmu.
                        <br/><b>Pubkvíz rezervuje pouze jeden z&nbsp;týmu!</b>
                        @if (Model.PubQuizSoloAvailable)
                        {
                            <br/>
                            <span>
                                Pokud nemáš tým, <b>vyplň libovolné neprázdné jméno týmu</b> a&nbsp;jako počet členů zvol <b>1</b>.
                                Na místě z&nbsp;vás pak tým poskládáme
                                (pozor, v&nbsp;takovém případě bude zarezervováno pouze jedno „sólo“ místo nehledě
                                na počet osob v&nbsp;rezervaci).
                            </span>
                        }
                    </p>
                    <div class="row mb-3">
                        <div class="col-8">
                            <label for="inputQuizTeamName" class="form-label">Jméno týmu:</label>
                            <input type="text" class="form-control"
                                   id="inputQuizTeamName" asp-for="InputModel.PubQuizTeamName">
                        </div>
                        <div class="col-4">
                            <label for="inputQuizTeamSeats" class="form-label">Počet členů:</label>
                            <input type="number" class="form-control" min="@Model.MinPubQuizTeamSize"
                                   max="@SeatsOptions.Value.MaxPubQuizTeamSize"
                                   id="inputQuizTeamSeats" asp-for="InputModel.PubQuizSeats">
                        </div>
                    </div>
                }
                <hr/>*@

                @foreach (var activity in Model.Slots.Values)
                {
                    <h3>@activity.Name</h3>
                    if (activity.TimeSlots.TrueForAll(x => !x.IsAvailable))
                    {
                        <p>
                            Všechny termíny jsou už bohužel plné.
                            Zkus se sem občas mrknout, zda se třeba nějaký neuvolnil.
                        </p>
                    }
                    else
                    {
                        <div class="container p-0">
                            <div class="row">
                                @foreach (var slot in activity.TimeSlots)
                                {
                                    <partial name="_TimeSlotPartial"
                                             model="@(slot, Model.InputModel.SelectedTimeSlotIds.GetValueOrDefault(slot.ActivityId) == slot.Id)"/>
                                }
                            </div>
                        </div>
                    }

                    <hr/>
                }

                <div class="d-grid gap-2 d-md-block">
                    <button type="submit"
                            class="btn btn-primary">@(Model.EditMode ? "Upravit rezervaci" : "Vytvořit rezervaci")</button>

                    @if (isAdmin)
                    {
                        <button type="submit" asp-page-handler="AdminSubmit"
                                asp-route-email="@Model.InputModel.Email" asp-route-token="_edit"
                                class="btn btn-warning">@(Model.EditMode ? "Vynutit úpravu" : "Vynutit rezervaci")</button>

                        @if (Model.EditMode)
                        {
                            <a asp-page="Cancel" asp-route-email="@Model.Email" asp-route-token="_edit"
                               class="btn btn-danger">Zrušit rezervaci</a>
                        }
                    }
                </div>
            </form>

            <p>
                Do mailu ti přijde odkaz na potvrzení, úpravu a&nbsp;na zrušení rezervace. Nezapomeň rezervaci potvrdit!
            </p>
        }
    </div>
</div>

@if (isAdmin)
{
    <div class="row justify-content-center pb-2">
        <div class="col-10">
            <a asp-page="Admin" class="btn btn-outline-secondary">Admin</a>
            <a asp-page="Admin" asp-page-handler="Logout" class="btn btn-outline-secondary">Odhlásit</a>
        </div>
    </div>
}