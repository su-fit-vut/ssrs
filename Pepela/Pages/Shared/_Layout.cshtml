<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Start@FIT 2026</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dosis&family=Exo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    
    <meta name="author" content="Studentská unie FIT VUT v Brně" />
    <meta
        name="description"
        content="Nabitá akce pro prváky na FIT"
    />

    <meta property="og:title" content="@ViewData["Title"] - Start@FIT 2026" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@Html.Raw("https://su.fit.vut.cz/noc" + Context.Request.Path)" />
    <link rel="canonical" href="@Html.Raw("https://su.fit.vut.cz/noc" + Context.Request.Path)" />
    <meta property="og:image" content="https://su.fit.vut.cz/noc/meta.jpg"/>

    <link rel="icon" type="image/x-icon" href="/img/favicon.png" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container justify-content-start">
            <a class="navbar-brand" asp-area="" asp-page="/Index">
                <img style="max-height: 50px" src="~/logo_horizontalni_1024px.png" alt="Studentská unie FIT VUT v Brně"/>
            </a>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>