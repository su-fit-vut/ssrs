@using NodaTime
@model ValueTuple<Pepela.Models.TimeSlot, bool>
@{
    Layout = null;
    var slot = Model.Item1;
    var name = $"InputModel.SelectedTimeSlotIds[{slot.ActivityId}]";
    var formatProviderCs = System.Globalization.CultureInfo.GetCultureInfo("cs-CZ");
    var isAdmin = await AuthorizationService.AuthorizeAsync(User, "IsAdmin") is { Succeeded: true };
    var slotAvailable = slot is { IsAvailable: true, IsReservable: true } || isAdmin;
}

<div class="col-6 col-md-4 col-lg-3 col-xl-2">
    <div class="card mb-3 @(slotAvailable ? "" : "not-available") timeslot-card">
        <div class="card-body">
            <h6 class="card-title mb-1">@slot.Start.ToString("dddd", formatProviderCs)</h6>
            <h6 class="card-title">@slot.Start.ToString("HH:mm", null)–@slot.End.ToString("HH:mm", null)
                @if (isAdmin)
                {
                    <a asp-page="SlotInfo" asp-route-id="@slot.Id">[info]</a>
                }
            </h6>
            <h6 class="card-subtitle mb-1 text-muted">
                @if (slot.IsAvailable)
                {
                    @:volno: @slot.AvailableSeats/@slot.TotalSeats
                }
                else
                {
                    @:plně obsazeno
                }
            </h6>
            @if (slot.Note != null)
            {
                <p class="card-text mb-1">@Html.Raw(slot.Note)</p>
            }
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="@name" id="@name-@slot.Id" value="@slot.Id"
                       @(slotAvailable ? "" : "disabled") @(Model.Item2 ? "checked" : "")/>
                <label class="form-check-label" for="@name-@slot.Id">
                    Zarezervovat
                </label>
            </div>

            @if (slot is { IsReservable: false, ReserveDateBound: not null })
            {
                if (slot.ReserveDateBound.Value.ToInstant() < SystemClock.Instance.GetCurrentInstant())
                {
                    <span>Už nelze rezervovat</span>
                }
                else
                {
                    <span>Lze rezervovat od @Html.Raw(slot.ReserveDateBound.Value.ToString("d. M. HH:mm", formatProviderCs).Replace(" ", "&nbsp;"))</span>
                }
            }
        </div>
    </div>
</div>